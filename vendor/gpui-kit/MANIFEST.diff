--- Cargo.toml.orig
+++ Cargo.toml
@@ -10,10 +10,25 @@
 repository = "https://github.com/longbridge/gpui-kit"
 readme = "README.md"
 publish = true
-edition.workspace = true
+edition = "2024"
 
-[lints]
-workspace = true
+[lints.clippy]
+almost_complete_range = "allow"
+arc_with_non_send_sync = "allow"
+borrowed_box = "allow"
+dbg_macro = "deny"
+let_underscore_future = "allow"
+manual_is_multiple_of = "allow"
+map_entry = "allow"
+module_inception = "allow"
+non_canonical_partial_ord_impl = "allow"
+redundant_clone = "deny"
+reversed_empty_ranges = "allow"
+single_range_in_vec_init = "allow"
+style = { level = "allow", priority = -1 }
+todo = "deny"
+type_complexity = "allow"
+useless_conversion = "allow"
 
 [features]
 default = ["component", "assets", "x11"]
@@ -78,26 +93,28 @@
 tree-sitter-zig = ["component", "gpui-component/tree-sitter-zig"]
 
 [dependencies]
-gpui_macros.workspace = true
-gpui.workspace = true
-gpui-fast = { workspace = true, optional = true }
-gpui-base.workspace = true
-gpui-component = { workspace = true, optional = true }
-gpui-kit-assets = { workspace = true, optional = true }
+gpui_macros = { package = "gpui-pre-macros", version = "=0.3.14" }
+gpui = { package = "gpui-pre", version = "=0.3.14" }
+gpui-fast = { package = "gpui-fast", version = "0.1.19", features = ["windows-manifest-provided-by-host"], optional = true }
+gpui-base = { version = "0.11.0" }
+gpui-component = { version = "0.11.0", optional = true }
+gpui-kit-assets = { version = "0.11.0", optional = true }
 
-[target.'cfg(not(any(target_os = "ios", target_os = "android")))'.dependencies]
-gpui_platform.workspace = true
-gpui-fast-platform = { workspace = true, optional = true }
+[target.'cfg(not(any(target_os = "ios", target_os = "android", target_family = "wasm")))'.dependencies]
+gpui_platform = { package = "gpui-pre-platform", version = "=0.3.14", features = ["font-kit", "wayland", "runtime_shaders"] }
+gpui-fast-platform = { package = "gpui-fast-platform", version = "0.1.19", features = ["font-kit", "wayland", "runtime_shaders"], optional = true }
 
 [target.'cfg(target_family = "wasm")'.dependencies]
-gpui_web.workspace = true
-gpui-fast-web = { workspace = true, optional = true }
+gpui_platform = { package = "gpui-pre-platform", version = "=0.3.14", features = ["font-kit", "wayland", "runtime_shaders"], default-features = false }
+gpui_web = { package = "gpui-pre-web", version = "=0.3.14", default-features = false }
+gpui-fast-platform = { package = "gpui-fast-platform", version = "0.1.19", features = ["font-kit", "wayland", "runtime_shaders"], default-features = false, optional = true }
+gpui-fast-web = { package = "gpui-fast-web", version = "0.1.19", default-features = false, optional = true }
 
 [dev-dependencies]
-gpui = { workspace = true, features = ["test-support"] }
-gpui-fast = { workspace = true, features = ["test-support"] }
+gpui = { package = "gpui-pre", version = "=0.3.14", features = ["test-support"] }
+gpui-fast = { package = "gpui-fast", version = "0.1.19", features = ["windows-manifest-provided-by-host", "test-support"] }
 jiff = "1.0"
-lsp-types.workspace = true
+lsp-types = { version = "0.97.0", features = ["proposed"] }
 
 [[test]]
 name = "ui"
